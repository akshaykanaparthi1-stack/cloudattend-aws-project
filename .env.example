# ========================================================
# CloudAttend — Environment Configuration Example
# Copy this file to .env and configure for your environment
# ========================================================

# Flask Environment: development | production | testing
FLASK_ENV=development

# Security Secret Key (Generate a strong random secret in production)
# Example generation: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=replace-with-a-very-long-random-secret-key-32-chars-min

# Port to run on (default 5000)
PORT=5000

# SQLite Persistent Database Path
# For Local Dev: instance/cloudattend.db
# For AWS EC2 Linux: /var/lib/cloudattend/cloudattend.db (or /home/ubuntu/cloudattend/instance/cloudattend.db)
DATABASE_PATH=instance/cloudattend.db

# Set to True when using HTTPS in production to ensure cookies only transmit over TLS
SESSION_COOKIE_SECURE=False

# Initial Admin User Credentials (Only used during first-time database seed)
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=Admin@Cloud2026
DEFAULT_ADMIN_NAME="Admin"
DEFAULT_ADMIN_EMAIL=admin@cloudattend.internal
